# SMTP server hostname (e.g. smtp.gmail.com, smtp.office365.com)
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to "true" for port 465 SSL; leave empty/false for STARTTLS on 587
SMTP_SECURE=false

# SMTP login username (usually your full email address)
EMAIL_USER=

# SMTP password or provider app password (never use your main account password)
EMAIL_PASS=

# From header shown on outgoing mail (e.g. "Famous Tours <info@example.com>")
EMAIL_FROM=

# Inbox that receives booking requests and contact-form messages
EMAIL_TO=
